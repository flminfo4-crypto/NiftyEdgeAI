# Copy this file to .env and fill in your Dhan credentials.
# Get them from web.dhan.co -> My Profile -> DhanHQ Trading APIs & Access
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# Local SQL Server (SQLEXPRESS instance), SQL Authentication
MSSQL_SERVER=localhost\SQLEXPRESS
MSSQL_DATABASE=NiftyEdge
MSSQL_USER=your_sql_login
MSSQL_PASSWORD=your_sql_password
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
