# Copy to .env and adjust. All values shown are the mock/dev defaults
# (app/config.py falls back to these even with no .env present at all).

# "mock" | "dhan" | "fyers" | "angel_one" — mock and dhan are implemented.
BROKER_ADAPTER=mock

# Required when BROKER_ADAPTER=dhan. Generate the access token from
# web.dhan.co -> My Profile -> DhanHQ Trading APIs (tokens expire — typically
# 24h — regenerate and update here when API calls start returning 401).
# DHAN_CLIENT_ID=1000000001
# DHAN_ACCESS_TOKEN=eyJ...

# Comma-separated list, or * for dev.
CORS_ALLOW_ORIGINS=*

# Risk engine (backend/app/services/risk_engine.py)
RISK_MAX_EXPOSURE_PCT=60.0
RISK_MAX_LOTS_PER_ORDER=300
RISK_MAX_DAILY_LOSS=25000.0

DEFAULT_EXPIRY=2026-07-31

# Not used yet — placeholders for when the backend moves off the in-memory store.
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/niftyedgeai
# REDIS_URL=redis://localhost:6379/0
